<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares membership tables through IMembershipTable on the same databases. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1303;CA1812;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Engine.cs" Link="Engine.cs" />
    <None Include="..\Scarlet.Orleans.Persistence.Benchmarks\InBoxScripts\*-Main.sql" Link="InBoxScripts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="InBoxScripts\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Clustering\Scarlet.Orleans.Clustering.AdoNet\Scarlet.Orleans.Clustering.AdoNet.csproj" />
    <ProjectReference Include="..\..\src\Clustering\Scarlet.Orleans.Clustering.EntityFrameworkCore\Scarlet.Orleans.Clustering.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.Runtime" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" />
  </ItemGroup>

</Project>
