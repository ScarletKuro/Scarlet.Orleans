<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared\Streaming.Shared.props" />

  <PropertyGroup>
    <Description>Orleans persistent streams over relational databases with plain ADO.NET: SQL Server, PostgreSQL, MySQL, MariaDB and SQLite. NativeAOT compatible.</Description>
    <PackageTags>orleans;streaming;streams;queue;ado.net;sql;postgresql;mysql;mariadb;sqlite;sqlserver</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SharedSourceRoot)AdoNet/**/*.cs" LinkBase="Shared/AdoNet" />
    <EmbeddedResource Include="..\Shared\Schema\*.sql" LogicalName="%(Filename)%(Extension)" />
    <None Include="..\Shared\Schema\*.sql" Pack="true" PackagePath="schema/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Streaming" />
    <PackageReference Include="System.IO.Hashing" />
    <!-- Build time only: generates the serializer of the batch container, which Orleans sends to consumer grains. Its
         runtime parts come with Microsoft.Orleans.Streaming. -->
    <PackageReference Include="Microsoft.Orleans.Sdk" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scarlet.Orleans.Streaming.AdoNet.Tests" />
    <InternalsVisibleTo Include="Scarlet.Orleans.Streaming.AdoNet.NativeAotTests" />
  </ItemGroup>

</Project>
