<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared\Reminders.Shared.props" />

  <PropertyGroup>
    <Description>Orleans reminders on EF Core, over the same schema as Scarlet.Orleans.Reminders.AdoNet. The Orleans tables can join the application's own DbContext and migrations.</Description>
    <PackageTags>orleans;reminders;entityframeworkcore;efcore;sql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SharedSourceRoot)EntityFrameworkCore/**/*.cs" LinkBase="Shared/EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Runtime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scarlet.Orleans.Reminders.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
