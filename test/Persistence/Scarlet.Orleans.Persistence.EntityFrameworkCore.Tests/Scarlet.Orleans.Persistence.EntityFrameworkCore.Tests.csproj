<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <Using Include="Xunit" />
    <!-- The ADO.NET flavour's scripts, which the EF Core model must reproduce exactly. -->
    <None Include="..\..\..\src\Persistence\Shared\Schema\*.sql" Link="Schema\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Persistence\Scarlet.Orleans.Persistence.EntityFrameworkCore\Scarlet.Orleans.Persistence.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\External\Orleans.Persistence.TestKit\Orleans.Persistence.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
  </ItemGroup>

</Project>
